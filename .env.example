# Optional Bluesky credentials, used only to search hashtags (A6, D20).
#
# Without them, hashtags are searched without logging in. That works only
# while Bluesky allows it: it blocks unauthenticated search at times, to
# reduce load. With them, hashtag search always works.
#
# 1. In Bluesky, create an app password: Settings > Privacy and security >
#    App passwords. Never use your account's own password.
# 2. Copy this file to .env (git-ignored, never copied into an image) and
#    fill it in with an editor, not with `echo`, so the password does not
#    end up in your shell history:
#        cp .env.example .env && chmod 600 .env
# 3. Run `make start`. It stores both values as the Secret
#    ingest/bluesky-credentials, which only the hashtag ingestor mounts.
#
# Format: KEY=value, one per line, with no spaces around "=". Quotes are
# not needed; one pair around the value is removed.
# To remove the credentials, empty both values (or delete .env) and run
# `make start` again: the Secret is deleted.

# Your handle (e.g. someone.bsky.social) or the email of the account.
BLUESKY_IDENTIFIER=
# The app password, e.g. abcd-efgh-ijkl-mnop.
BLUESKY_APP_PASSWORD=
